// プレイヤーの調整値。PlayerConfig.cpp が最初の1回だけ読む。
// キーがないときは PlayerConfig.cpp に書いてある値（このファイルを作ったときと同じ値）を使い、出力ウィンドウに出す。
// 「〇〇Frames」「〇〇Frame」はアニメーションのコマ数（30fps、クリップの先頭を 0コマ目と数える）。コードで秒にする。
{
	"maxHp": 100.0,

	// 弾に当たる球。
	"hit": {
		"radius": 45.0,
		"centerHeight": 70.0 // 足元から当たり判定の中心までの高さ（胸のあたり）。
	},

	// 魔法を撃つ位置。
	"caster": {
		"height": 140.0, // 三人称時、足元からこの高さで撃つ（胸のあたり）。
		"forward": 60.0  // 自分のカプセル（半径20）に当たらないよう前に出して撃つ。
	},

	"move": {
		// 歩きは原神のような落ち着いた速さにする（Walk アニメーションを約1.3倍で再生して足をそろえる）。
		"walkSpeed": 170.0,
		"runSpeed": 480.0,
		"jumpSpeed": 400.0,
		"gravity": 980.0,
		"capsuleRadius": 20.0,
		"capsuleHeight": 100.0,
		"turnSpeedDeg": 360.0, // 向きを変える速さ（度/秒）。180° 振り向くのに 0.5秒。向いている方へ進むので、曲がるときは弧を描く。0 ならすぐ向き、入力の方へすぐ進む。
		"moveThreshold": 0.1 // 移動入力がこれより小さければ立ち止まる。
	},

	// ダッシュのクリップ（原神の動画の 33.41〜33.94秒、30fps・17コマ）の区間に合わせる。
	//   しゃがむ 0〜4コマ目（4コマ）、蹴って低く滑る 4〜11コマ目（7コマ）、着地 11〜16コマ目（5コマ）。
	"dash": {
		"distance": 390.0,       // ダッシュスキルの総移動距離（はじめ 300、1.3倍にした）。
		"kickFrames": 7,         // distance をこのコマ数で進む（速さはコードで distance ÷ 時間にする。390 なら平均 約1671）。
		"endSpeed": 480.0,       // 終わりは走る速さ。蹴った瞬間は約2860 になる。
		"animSpeed": 1.0,        // 動画と同じ速さで流す。
		"animBlendSeconds": 0.05,
		"crouchFrames": 4,
		"crouchBlendSeconds": 0.1,
		"crouchSpeed": 200.0,    // 入った勢いで少し進み、止まってから飛び出す。
		"kickStartFrame": 4,
		"landFrames": 5,
		"exitBlendSeconds": 0.15, // ダッシュの最後と走りの始めは同じ形なので、短くてよい。
		// ダッシュのあとの走り・歩きの始め。ダッシュの最後（原神の動画の 33.94秒）と同じ足の形のところ。
		// Run（原神の走りの1周期、30fps・15コマ）は 5コマ目、Walk は先頭（0コマ目）。
		"toRunStartFrame": 5,
		"toWalkStartFrame": 0,
		"landIntoRun": true,     // 走るなら、着地（5コマ）の間にダッシュから走りへ補間する。
		"canChain": false,       // 着地まで終わるまで入力を受け付けない（連打で続けて出さない）。
		"endWithStop": true,     // ダッシュのあと入力がなければ、勢いで滑って止まる。
		"keepRun": true          // ダッシュのあとは、移動の入力を離すまで走り続ける（ちょこちょこ歩きに戻らない）。
	},

	// 走りから止まる。StopL / StopR（原神の動画の 29.78〜30.89秒、30fps・34コマ）に合わせる。
	//   0〜4コマ目 前の足を着いて腰を落とす、4〜14コマ目 突っ張って低く滑る、14〜33コマ目 起き上がって立つ。
	"stop": {
		"frames": 30,            // 立ち上がったところ（Stop の 30コマ目）で Idle へ移る。
		"slideFrames": 14,       // 走る速さ（480）から 0.47秒で止まる。約112 滑る。
		"blendSeconds": 0.1,
		"exitBlendSeconds": 0.3,
		"afterRunSeconds": 0.2,  // 左Shift を移動キーより 0.2秒まで先に離しても滑って止まる。
		// Run（15コマ、最後は最初と同じ）で、前の足が地面に着くところ。右足は Run の 2コマ目、左足は 9コマ目。
		"runAnimFrames": 14,
		"stopLRunFrame": 9,
		"stopRRunFrame": 2
	},

	"model": {
		"path": "Assets/modelData/player/Model/SK_Player.FBX",
		"upAxis": "Z",  // 3ds Max（Z-up）で作られているので Z を上にして起こす（Y のままだと仰向けに倒れる）。
		"scale": 1.128  // UnityChan（Enemy）の2倍の高さ（1.692）を狙った後、実機で大きすぎたのでその2/3にした。
	},

	// 体の傾き（見た目だけ。足元を中心に傾ける）。
	"lean": {
		"enabled": true,
		"turnLeanScale": 0.2,          // 曲がるとき内側へ。物理の傾き（遠心力と重力の釣り合い）の 0.2倍。
		"maxTurnLeanDeg": 12.0,
		"accelLeanScale": 0.12,        // 速くなるとき前へ、遅くなるとき後ろへ。物理の傾きの 0.12倍。
		"maxAccelLeanDeg": 8.0,
		"velocitySmoothSeconds": 0.15, // 移動の速さは一瞬で変わるので、この時間でならしてから加速を求める。
		"leanSmoothSeconds": 0.1       // 傾きが目標に追いつく時間。
	},

	// 髪・スカートなどの揺れ物（骨の名前が J_Sec_ で始まるもの）。アニメーションの形へばねで引き戻す。
	//   frequency: 1秒に何回揺れるか（大きいほど硬い）。dampingRatio: 1 で揺り返さない、小さいほど何度も揺れる。
	//   maxAngleDeg: アニメーションの形から曲がってよい角度。match: 骨の名前に入っている文字（いくつも当てはまるときは長い方）。
	"springBone": {
		"enabled": true,
		"legRadius": 8.0, // 太もも・すねの太さ。揺れ物の先がこれより脚に近づかない（アニメーションの形がもとから近いときはそこまで）。
		"groups": {
			"hair":      { "match": "Hair",      "frequency": 2.5, "dampingRatio": 0.35, "maxAngleDeg": 40.0 },
			"coatSkirt": { "match": "CoatSkirt", "frequency": 2.5, "dampingRatio": 0.4,  "maxAngleDeg": 35.0 },
			"skirt":     { "match": "Skirt",     "frequency": 3.0, "dampingRatio": 0.5,  "maxAngleDeg": 25.0 },
			"bust":      { "match": "Bust",      "frequency": 4.0, "dampingRatio": 0.25, "maxAngleDeg": 8.0 }
		}
	},

	"animation": {
		"blendSeconds": 0.2, // アニメーションを切り替えるときの補間時間。
		// Walk.fbx（Mixamo の Female Walk）の足が地面を送る速さ。UE で足のボーンを測った 115/秒 × モデルの大きさ 1.128。
		"walkMoveSpeed": 130.0,
		// クリップの名前は PlayerConfig.cpp の対応表（Idle・Walk・Run・Jump・Dash・StopL・StopR）と同じにする。
		"clips": {
			// Idle・Walk は Mixamo のモーションを UE で SK_Player にリターゲットしたもの。
			"Idle": { "path": "Assets/modelData/player/Animation/Idle.fbx", "loop": true },
			"Walk": { "path": "Assets/modelData/player/Animation/Walk.fbx", "loop": true },
			// Run・Dash は、原神の動画から MediaPipe で関節の位置を読み取り、その角度で SK_Player のポーズを作ったもの
			// （tools/UnrealScripts/dash_roto.json）。Run は走りの1周期（34.25〜34.72秒）。
			"Run": { "path": "Assets/modelData/player/Animation/Run.fbx", "loop": true },
			// Jump はまだ SK_Player 用が無いので、暫定で Run を入れておく。
			"Jump": { "path": "Assets/modelData/player/Animation/Run.fbx", "loop": true },
			// Dash は「しゃがむ → 左足で蹴って低く滑る → 着地」の通し（33.41〜33.94秒）。原神と同じく、蹴る足はいつも同じ。
			"Dash": { "path": "Assets/modelData/player/Animation/Dash.fbx", "loop": false },
			// StopL・StopR は走りから止まる「前の足を突っ張って滑る → 起き上がる」の通し（29.78〜30.89秒、L・R は突っ張る足。
			// tools/UnrealScripts/stop_roto.json）。
			"StopL": { "path": "Assets/modelData/player/Animation/StopL.fbx", "loop": false },
			"StopR": { "path": "Assets/modelData/player/Animation/StopR.fbx", "loop": false }
		}
	},

	// 右手に持つ剣。付けるボーンの名前はモデルの作りで決まるので、コード（PlayerConfig.cpp）に置いている。
	"sword": {
		"path": "Assets/modelData/weapon/sowrd/sowrd.tkm",
		"offset": [5.0, -3.0, 10.0],         // 右手ボーンのローカル空間での剣の位置のずれ。
		"rotationOffsetDeg": [0.0, 0.0, -90.0], // 剣のモデルの Z 軸が手の向きと 90度ずれているため直す。
		"scale": [1.35, 1.35, 1.35],
		"castShadow": true
	}
}
