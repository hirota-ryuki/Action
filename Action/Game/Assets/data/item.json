// アイテムの調整値。ItemConfig.cpp が最初の1回だけ読む。
// キーがないときは ItemConfig.cpp に書いてある値（このファイルを作ったときと同じ値）を使い、出力ウィンドウに出す。
{
	// 落ちているアイテムを拾う（F）。
	"pickup": {
		"radius": 150.0,             // プレイヤーの足元からこの距離以内のアイテムを、拾える一覧に出す。
		"holdDelaySeconds": 0.3,     // F を押し続けて、この秒数たったら、まとめて拾い始める。
		"holdIntervalSeconds": 0.05  // まとめて拾うときに、1つ拾う間隔（秒）。
	},

	// 落ちているアイテムの動き（どのアイテムも同じ）。
	"look": {
		"floatAmplitude": 5.0,   // 上下にゆれる幅（片側）。
		"floatSeconds": 2.0,     // 上下にゆれる1往復の秒数。
		"spinDegPerSecond": 90.0 // 1秒に回る角度。
	},

	"potion": {
		// Meshy で作った瓶。原点が瓶の真ん中にある。
		"modelPath": "Assets/modelData/item/Potion/Potion.fbx",
		"modelScale": 0.5,          // プレイヤーの膝より少し低いくらいにする。
		"floatHeight": 30.0,        // 地面から瓶の真ん中までの高さ。瓶の底が地面から少し浮く。
		"startCount": 2,            // ゲームを始めたときに持っている数。
		"healAmount": 30.0,         // 1つ飲むと回復する HP。押した瞬間にまとめて回復する。
		"drinkSeconds": 0.6,        // 飲んだあとの硬直の長さ（秒）。この間は魔法・ダッシュ・ジャンプができない。
		"drinkMoveSpeedRate": 0.5   // 硬直の間に歩ける速さ（歩く速さに掛ける）。
	},

	// ゲームを始めたときにポーションを置く位置 [x, z]。y は地面に合わせる。
	// プレイヤーは (0, 0) から始まる。まとめて拾うのを試せるよう、右前に3つ固めて置く。
	"potionSpawns": [
		[ 150.0, 200.0 ],
		[ 190.0, 230.0 ],
		[ 130.0, 250.0 ],
		[ -250.0, 150.0 ]
	]
}
