// 魔法の強さ。MagicSettings.cpp が最初の1回だけ読み、Player も敵も同じ値を使う。
// キーがないときは MagicSettings.h に書いてある値（このファイルを作ったときと同じ値）を使い、出力ウィンドウに出す。
// エフェクトの大きさなど見た目の値はコード（IceBullet.cpp・FireBullet.cpp）にある。
{
	// 氷魔法（左クリック）。押した瞬間に1発撃ち、当たった相手を凍らせる。
	"ice": {
		"cooldown": 0.35,      // 連射間隔（秒）。
		"speed": 1500.0,       // 弾が毎秒進む距離。
		"range": 2000.0,       // 弾がこれだけ飛ぶと消える。
		"radius": 10.0,        // 弾の当たり判定の半径。
		"freezeSeconds": 2.5   // 当たった相手を凍らせる秒数。
	},

	// 炎魔法（右クリック）。押している間に溜め、離すと撃つ。
	// 「min〜」は溜めなし、「max〜」は最大まで溜めたときの値で、間は溜め具合で補間する。
	"fire": {
		"cooldown": 0.6,            // 撃ってから次に溜め始められるまでの秒数。
		"maxChargeSeconds": 1.2,    // 最大まで溜まる秒数。
		"speed": 1300.0,            // 弾が毎秒進む距離。
		"range": 2000.0,            // 弾がこれだけ飛ぶと消える。
		"minRadius": 14.0,          // 弾の当たり判定の半径。
		"maxRadius": 45.0,
		"minGroundRadius": 130.0,   // 燃える床の半径。
		"maxGroundRadius": 300.0,
		"groundBurnSeconds": 4.0    // 床が燃えている秒数。
	}
}
