// 魔法の調整値。MagicConfig.cpp が最初の1回だけ読む。Player も敵も同じ値を使う。
// キーがないときは MagicConfig.cpp に書いてある値（このファイルを作ったときと同じ値）を使い、出力ウィンドウに出す。
// 見た目と作りの値（エフェクトの拡大率、床を探すレイの長さなど）は、それぞれの魔法の .cpp にある。
{
	// 氷魔法（IceMagic）。押した瞬間に飛び出し、当たった相手を凍らせる。
	"ice": {
		"cooldown": 0.35,     // 連射間隔（秒）。
		"speed": 1500.0,      // 毎秒の移動距離。
		"range": 2000.0,      // これだけ飛ぶと消える。
		"radius": 10.0,       // 当たり判定の半径。
		"freezeSeconds": 2.5  // 当たった相手を凍らせる秒数。
	},

	// 炎魔法（FireMagic）。押している間は溜め、離すと飛ぶ。溜めるほど大きく、燃える床が広くなる。
	// min〜max は、溜めなし〜最大まで溜めたときの値。間は溜め具合で補間する。
	"fire": {
		"cooldown": 0.6,            // 撃ってから次に溜め始められるまでの秒数。
		"maxChargeSeconds": 1.2,    // 最大まで溜まる秒数。
		"speed": 1300.0,
		"range": 2000.0,
		"minRadius": 14.0,          // 当たり判定の半径。
		"maxRadius": 45.0,
		"minGroundRadius": 130.0,   // 炎魔法発射後の燃える床の半径。
		"maxGroundRadius": 300.0,
		"groundBurnSeconds": 4.0    // 床が燃えている秒数。
	},

	// 黒騎士の斬撃（SlashMagic）。攻撃3（SlashWaveAttack）が飛ばす。
	"slash": {
		"speed": 1100.0,   // プレイヤーがよけられるくらいの速さ。
		"range": 1500.0,
		"radius": 45.0     // 三日月の幅（160）より小さめにして、端をかすっただけでは当たらないようにする。
	}
}
